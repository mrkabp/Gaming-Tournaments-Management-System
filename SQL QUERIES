1. WHERE
SELECT player_name, email
FROM Players
WHERE team_id = 1;

2. JOIN
SELECT Players.player_name, Teams.team_name
FROM Players
JOIN Teams
ON Players.team_id = Teams.team_id;

3. GROUP BY + COUNT
SELECT Teams.team_name, COUNT(Players.player_id) AS total_players
FROM Teams
JOIN Players
ON Teams.team_id = Players.team_id
GROUP BY Teams.team_name;

4. JOIN + WHERE
SELECT 
    Matches.match_id,
    Teams.team_name AS team1,
    Teams2.team_name AS team2,
    Matches.match_date
FROM Matches
JOIN Teams
ON Matches.team1_id = Teams.team_id
JOIN Teams AS Teams2
ON Matches.team2_id = Teams2.team_id
WHERE Matches.tournament_id = 1;
